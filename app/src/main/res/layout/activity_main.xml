<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    tools:context=".MainActivity">

    <!-- Top toolbar with status -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#16213E"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Opros Dev Environment"
        app:titleTextColor="#E0E0E0" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F3460"
        android:padding="8dp"
        android:text="Initializing..."
        android:textColor="#00D4FF"
        android:textSize="12sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Terminal output view -->
    <com.termux.TerminalView
        android:id="@+id/terminalView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintBottom_toTopOf="@id/tvTerminalOutput"
        app:layout_constraintVertical_weight="3" />

    <!-- AI system prompt display (hidden by default) -->
    <TextView
        android:id="@+id/tvTerminalOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#16213E"
        android:maxHeight="200dp"
        android:padding="12dp"
        android:textColor="#A0D0A0"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/actionBar" />

    <!-- Action buttons bar -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#16213E"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintBottom_toTopOf="@id/keyboardBar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLaunchOpenCode"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="OpenCode"
            android:textSize="10sp"
            app:icon="@drawable/ic_ai" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLaunchDebian"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Debian"
            android:textSize="10sp"
            app:icon="@drawable/ic_linux" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLaunchTermux"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Termux"
            android:textSize="10sp"
            app:icon="@drawable/ic_terminal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowAiPrompt"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="AI Info"
            android:textSize="10sp"
            app:icon="@drawable/ic_info" />

    </LinearLayout>

    <!-- Extra keyboard bar -->
    <LinearLayout
        android:id="@+id/keyboardBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#0F3460"
        android:orientation="horizontal"
        android:padding="2dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_extra_key"
            android:text="TAB"
            android:textColor="#E0E0E0"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnCtrl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_extra_key"
            android:text="CTRL"
            android:textColor="#E0E0E0"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnEsc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_extra_key"
            android:text="ESC"
            android:textColor="#E0E0E0"
            android:textSize="11sp" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_extra_key"
            android:text="/"
            android:textColor="#E0E0E0"
            android:textSize="11sp" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_extra_key"
            android:text="-"
            android:textColor="#E0E0E0"
            android:textSize="11sp" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_extra_key"
            android:text="|"
            android:textColor="#E0E0E0"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
